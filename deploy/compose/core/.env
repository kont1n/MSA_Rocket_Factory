# ----------------------------
# Настройки Kafka
# ----------------------------

# Внешний порт Kafka, через который клиенты подключаются снаружи контейнера
KAFKA_EXTERNAL_PORT=9092

# Внутренний порт Kafka, который используется внутри docker-сети
KAFKA_INTERNAL_PORT=29092

# Порт контроллера Kafka (используется при работе в режиме KRaft)
KAFKA_CONTROLLER_PORT=29093

# Порт для веб-интерфейса Kafka UI (например, Kafdrop, Redpanda Console)
KAFKA_UI_PORT=8090

# ----------------------------
# OPENTELEMETRY COLLECTOR
# ----------------------------

# Порт OTLP gRPC
OTEL_GRPC_PORT=4317

# Размер пакета batch processor
OTEL_BATCH_SIZE=1000

# Таймаут batch processor
OTEL_BATCH_TIMEOUT=10s

# Порт метрик самого коллектора
OTEL_METRICS_PORT=8889

# Уровень логирования
OTEL_LOG_LEVEL=detailed

# ----------------------------
# Jaeger
# ----------------------------

# Хост Jaeger
JAEGER_HOST=jaeger

# Порт Jaeger
JAEGER_PORT=4317

# Порт UI Jaeger
JAEGER_UI_PORT=16686

# ----------------------------
# PROMETHEUS
# ----------------------------

# Хост Prometheus
PROMETHEUS_HOST=prometheus

# Порт Prometheus
PROMETHEUS_PORT=9090

# Интервал оценки правил
PROMETHEUS_EVALUATION_INTERVAL=15s

# ----------------------------
# GRAFANA
# ----------------------------

# Порт Grafana
GRAFANA_PORT=3000

# Логин администратора
GRAFANA_ADMIN_USER=admin

# Пароль администратора
GRAFANA_ADMIN_PASSWORD=administrator

# Имя datasource
GRAFANA_DATASOURCE_NAME=Prometheus

# URL datasource
GRAFANA_DATASOURCE_URL=http://prometheus:9090

# Путь к дашбордам
GRAFANA_DASHBOARDS_PATH=/var/lib/grafana/dashboards