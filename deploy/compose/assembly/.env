# ----------------------------
# Настройки логгера
# ----------------------------

# Уровень логирования (debug, info, warn, error)
LOGGER_LEVEL=info

# Выводить логи в формате JSON (true/false)
LOGGER_AS_JSON=true

# Источники вывода логов (stdout, otlp, stdout,otlp)
LOG_OUTPUTS=stdout,otlp

# Адрес OTLP коллектора для отправки логов
OTEL_COLLECTOR_ENDPOINT=otel-collector:4317

# Имя сервиса для телеметрии
SERVICE_NAME=assembly


# ----------------------------
# Kafka настройки
# ----------------------------

# Адреса Kafka-брокеров через запятую
KAFKA_BROKERS=kafka:29092

# Название топика с событиями "Заказ оплачен"
CONSUMER_TOPIC_NAME=order.paid

# Идентификатор consumer group для обработки событий "Заказ оплачен"
CONSUMER_GROUP_ID=assembly-service

# Название топика с событиями "Корабль собран"
PRODUCER_TOPIC_NAME=ship.assembled