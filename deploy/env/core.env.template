# ----------------------------
# Настройки Kafka
# ----------------------------

# Внешний порт Kafka, через который клиенты подключаются снаружи контейнера
KAFKA_EXTERNAL_PORT=${CORE_KAFKA_EXTERNAL_PORT}

# Внутренний порт Kafka, который используется внутри docker-сети
KAFKA_INTERNAL_PORT=${CORE_KAFKA_INTERNAL_PORT}

# Порт контроллера Kafka (используется при работе в режиме KRaft)
KAFKA_CONTROLLER_PORT=${CORE_KAFKA_CONTROLLER_PORT}

# Порт для веб-интерфейса Kafka UI (например, Kafdrop, Redpanda Console)
KAFKA_UI_PORT=${CORE_KAFKA_UI_PORT}

# ----------------------------
# OPENTELEMETRY COLLECTOR
# ----------------------------

# Порт OTLP gRPC
OTEL_GRPC_PORT=${CORE_OTEL_GRPC_PORT}

# Размер пакета batch processor
OTEL_BATCH_SIZE=${CORE_OTEL_BATCH_SIZE}

# Таймаут batch processor
OTEL_BATCH_TIMEOUT=${CORE_OTEL_BATCH_TIMEOUT}

# Порт метрик самого коллектора
OTEL_METRICS_PORT=${CORE_OTEL_METRICS_PORT}

# Уровень логирования
OTEL_LOG_LEVEL=${CORE_OTEL_LOG_LEVEL}

# ----------------------------
# Jaeger
# ----------------------------

# Хост Jaeger
JAEGER_HOST=${CORE_JAEGER_HOST}

# Порт Jaeger
JAEGER_PORT=${CORE_JAEGER_PORT}

# Порт UI Jaeger
JAEGER_UI_PORT=${CORE_JAEGER_UI_PORT}

# ----------------------------
# PROMETHEUS
# ----------------------------

# Хост Prometheus
PROMETHEUS_HOST=${CORE_PROMETHEUS_HOST}

# Порт Prometheus
PROMETHEUS_PORT=${CORE_PROMETHEUS_PORT}

# Интервал оценки правил
PROMETHEUS_EVALUATION_INTERVAL=${CORE_PROMETHEUS_EVALUATION_INTERVAL}

# ----------------------------
# GRAFANA
# ----------------------------

# Порт Grafana
GRAFANA_PORT=${CORE_GRAFANA_PORT}

# Логин администратора
GRAFANA_ADMIN_USER=${CORE_GRAFANA_ADMIN_USER}

# Пароль администратора
GRAFANA_ADMIN_PASSWORD=${CORE_GRAFANA_ADMIN_PASSWORD}

# Имя datasource
GRAFANA_DATASOURCE_NAME=${CORE_GRAFANA_DATASOURCE_NAME}

# URL datasource
GRAFANA_DATASOURCE_URL=${CORE_GRAFANA_DATASOURCE_URL}

# Путь к дашбордам
GRAFANA_DASHBOARDS_PATH=${CORE_GRAFANA_DASHBOARDS_PATH}